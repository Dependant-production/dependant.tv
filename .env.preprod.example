# À configurer uniquement pour l’environnement Preview de Vercel.
# Cette URL doit être celle du Strapi de préproduction, jamais celle de production.
NEXT_PUBLIC_STRAPI_BASE_URL=https://cms-preprod.dependant.tv
DEPLOYMENT_ENV=preprod

# Jeton de lecture créé dans le Strapi de préproduction si l’API n’est pas publique.
STRAPI_API_TOKEN=
